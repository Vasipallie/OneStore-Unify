<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Password Generator - OneStore Unify</title>
    <link rel="icon" href="../assets/logo.png">
    <style>
    @font-face{
        font-family:'geo';
        src:url('../assets/geo.otf') format('opentype');
    }
    body{
        font-family: 'geo', sans-serif;
        background-color: #0f0f0f;
        color:#ffffff;
        margin: 0;
        box-sizing: border-box;
        background-image: url('../assets/bgs.jpg');
        background-size: cover;
        background-repeat: no-repeat;
        background-attachment: fixed;
        display: flex;
        height: 100vh;
    }
    h1{font-size:2.5rem;margin:0}
    .nav{width:23vw;padding:1.5rem;box-sizing:border-box;height:100vh;display:flex;flex-direction:column;background-color:#0000008e;backdrop-filter:blur(15px);border-right:1px solid #3F6491}
    .logo{display:flex;align-items:center;justify-content:center;gap:.5rem;font-size:1.5rem}
    hr{border:none;border-top:1px solid rgba(255,255,255,0.6);border-radius:1rem;width:100%;margin:1rem 0;box-sizing:border-box}
    .content{background-color:#00000046;height:100%;flex:1;padding:1.5rem;box-sizing:border-box;overflow:auto}
    .btn{padding:.5rem 1rem;font-size:1rem;border:none;border-radius:7px;background-color:#1270D0;color:#fff;text-decoration:none;cursor:pointer;align-self:center;font-family:'geo',sans-serif;width:100%;text-align:center;margin-block:.3rem}
    .logout-btn{margin-top:auto;background-color:#002087;box-shadow:0 0 10px rgba(18,112,208,0.5)}
    .panel{max-width:900px;margin-top:2rem;display:grid;grid-template-columns:360px 1fr;gap:1rem}
    .card{background:rgba(0,0,0,0.35);border:1px solid rgba(255,255,255,0.12);border-radius:12px;padding:1rem}
    .field{display:flex;flex-direction:column;gap:.4rem;margin-bottom:.9rem}
    .field input{padding:.7rem;border-radius:8px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);color:#fff}
    .generated{word-break:break-all;background:#000;padding:.6rem;border-radius:6px;margin-top:.5rem}
    </style>
</head>
<body>
    <div class="nav">
        <div class="logo"><img src="../assets/logo.png" alt="Logo" width="50" height="50"><span>OneStore Unify</span></div>
        <hr>
        <a class="btn" href="/dashboard">Dashboard</a>
        <a class="btn" href="/passwords">Password Manager</a>
        <a class="btn" href="/password-gen">Password Generator</a>
        <a class="btn logout-btn" href="/logout">OneStore Logout</a>
    </div>
    <div class="content">
        <span style="font-size:1.25em">Password tools</span>
        <h1>Password Generator</h1>
        <div class="panel">
            <div class="card">
                <h2>Generate a secure password</h2>
                <form action="/password-gen" method="POST">
                    <div class="field">
                        <label for="length">Length (characters)</label>
                        <input id="length" name="length" type="number" min="8" max="128" value="32">
                    </div>
                    <button class="btn" type="submit">Generate</button>
                </form>
                <% if (generated) { %>
                    <div style="margin-top:.75rem">
                        <label>Generated</label>
                        <div class="generated"><%= generated %></div>
                        <button class="btn" onclick="navigator.clipboard.writeText('<%= generated %>')">Copy</button>
                    </div>
                <% } %>
            </div>
            <div>
                <div class="card">
                    <h2>Notes</h2>
                    <p>Use this to create strong hex passwords. If you want mixed-character passwords (symbols, letters), ask me and I’ll change the generator to use a character set.</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>