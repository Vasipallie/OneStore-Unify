<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneStore Unify</title>
    <link rel="stylesheet" href="/styles.css">

    <style>
        
@import url('https://fonts.googleapis.com/css2?family=Stack+Sans+Notch:wght@200..700&display=swap');
body{
    font-family: "Stack Sans Notch", sans-serif;
    background-color: #0f0f0f;
    color:#ffffff;
    margin: 0;
    padding: 1rem;
    box-sizing: border-box;
    background-image: url('../assets/bgs.jpg');
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    align-items: center;
    height: 100vh;
}
h1{
    font-size: 2.5rem;
    margin:0;
}
.logo{
    width:6rem;
    height:6rem;
}

.login-contain{
    display:flex;
    flex-direction:column;
    background-color: rgba(0,0,0,0.5);
    min-width:25vw;
    height: auto;
    padding: 2rem;
    align-items: center;
    text-align: center;
    border-radius: 10px;
    backdrop-filter: blur(10px);
}

.notify{
    margin-block:0.5rem;
    background-color: rgba(8, 116, 159, 0.274);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.274);
    border:1px solid #c2c2c2;
    padding: 0.5rem 1rem;
    border-radius: 5px;
}
input{
    width: 100%;
    padding: 0.5rem;
    margin: 0.5rem 0;
    border: none;
    border-radius: 5px;
    
}

input[type="email"]{
    background-color:#ffffff;
    color:#000000;
    font-family: 'geo', sans-serif;
    backdrop-filter: blur(15px);
    margin:0;
    margin-block-start: 0.5rem;
    font-size: 1rem;
}
form{
    width:100%;
}
input[type="password"]{
    background-color:#ffffff;
    color:#000000;
    font-family: 'geo', sans-serif;
    backdrop-filter: blur(15px);
    margin-block: 0.5rem;
    font-size: 1rem;
}
input::placeholder{
    color:#3b3b3b;
    opacity: 0.7;
}
.input-field,.login-btn{
    align-self: stretch;
    box-sizing: border-box;
    display: block;
    width: 100%;
}
.login-btn{
    padding: 0.5rem 1rem;
    font-size: 1rem;
    border: none;
    border-radius: 7px;
    background-color: #1270D0;
    color: #ffffff;
    cursor: pointer;
    font-family: 'geo', sans-serif;
}
    
hr{
    border: none;
    border-top: 1px solid rgb(81, 128, 185);
    border-radius: 1rem;
    width: 100%;
}
.cforgot{
    display:flex;
    flex-direction:row;
    justify-content: space-between;
    width:100%;
    margin-block: 0.5rem;
}
a{
    color:#d4e9ff;
    text-decoration: none;
    width:5rem;
    gap:0.5rem;
}
a:hover{
    color:#7dbcff;
    text-decoration: none;
}
    </style>
    <link rel="icon" href="../assets/logo.png">
</head>
<body>
    <h1>OneStore Unify</h1>
    <a class="login-btn" href="/create">Create Account</a>
    <a class="login-btn" href="/login">Login</a>
</body>
</html>