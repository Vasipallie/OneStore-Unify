<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneStore Unify</title>
    <style>
    @font-face{
        font-family:'geo';
        src:url('../assets/geo.otf') format('opentype');
    }
    body{
        font-family: 'geo', sans-serif;
        background-color: #0f0f0f;
        color:#ffffff;
        margin: 0;
        box-sizing: border-box;
        background-image: url('../assets/bgs.jpg');
        background-size: cover;
        background-repeat: no-repeat;
        background-attachment: fixed;
        display: flex;
        height: 100vh;
    }
    h1{
        font-size: 2.5rem;
        margin:0;
    }
    .nav{
        width:23vw;
        padding:1.5rem;
        box-sizing: border-box;
        height: 100%;
        background-color:#0000008e;
        backdrop-filter:blur(15px);
        border-right:1px solid #ffffff8e;
    }

    .logo{
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 1.5rem;
    }
    hr{
        border: none;
        border-top: 1px solid #3F6491;
        border-radius: 1rem;
        border: 1px solid #3F6491;
    }
    .content{
        background-color:#00000046;
        height:100%;
        width: 77vw;
        padding: 1.5rem;
        box-sizing:border-box;
    }
    </style>
    <link rel="icon" href="../assets/logo.png">
</head>
<body>
    <div class="nav">
        <div class="logo"><img src="../assets/logo.png" alt="Logo" width="50" height="50"><span>OneStore Unify</span></div>
        <hr>
    </div>
    <div class="content">
        <h1>Dashboard</h1>
        <p>Welcome to the dashboard!</p>
    </div>

    
</body>
</html>