<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneStore Unify</title>
    <style>
    @font-face{
        font-family:'geo';
        src:url('../assets/geo.otf') format('opentype');
    }
    body{
        font-family: 'geo', sans-serif;
        background-color: #0f0f0f;
        color:#ffffff;
        margin: 0;
        box-sizing: border-box;
        background-image: url('../assets/bgs.jpg');
        background-size: cover;
        background-repeat: no-repeat;
        background-attachment: fixed;
        display: flex;
        height: 100vh;
    }
    h1{
        font-size: 2.5rem;
        margin:0;
    }
    .nav{
        width:23vw;
        padding:1.5rem;
        box-sizing: border-box;
        height: 100vh;
        display: flex;
        flex-direction: column;
        background-color:#0000008e;
        backdrop-filter:blur(15px);
        border-right:1px solid #3F6491;
    }

    .logo{
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 1.5rem;
    }
    hr{
        border: none;
        border-top: 1px solid rgba(255,255,255,0.6);
        border-radius: 1rem;
        width:100%;
        margin: 1rem 0;
        box-sizing: border-box;
    }
    .content{
        background-color:#00000046;
        height:100%;
        flex: 1;
        padding: 1.5rem;
        box-sizing:border-box;
    }
    span{
        font-size: 1.5rem;
    }
    .btn{
        padding: 0.5rem 1rem;
        font-size: 1rem;
        border: none;
        border-radius: 7px;
        background-color: #1270D0;
        color: #ffffff;
        text-decoration: none;
        cursor: pointer;
        align-self: center;
        font-family: 'geo', sans-serif;
        width:100%;
        text-align: center;
        margin-block: 0.3rem;
    }
    .logout-btn{
        margin-top: auto;
        background-color: #002087;
        box-shadow: 0 0 10px rgba(18, 112, 208, 0.5);
    }
    
    </style>
    <link rel="icon" href="../assets/logo.png">
</head>
<body>
    <div class="nav">
        <div class="logo"><img src="../assets/logo.png" alt="Logo" width="50" height="50"><span>OneStore Unify</span></div>
        <hr>
        
        <a class="btn" href="/dashboard">Dashboard Home</a>
        <a class="btn" href="/password-gen"></a>
        <a class="btn" href="/password-gen">Password Generator</a>
        <a class="btn logout-btn" href="/logout">OneStore Logout</a>
    </div>
    <div class="content">
        <span style="font-size: 1.25em;">Welcome back to OneStore Unify,</span>
        <h1>John BlackSmith</h1>               
    </div>

    
</body>
</html>