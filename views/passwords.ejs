<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneStore Unify - Passwords</title>
    <style>
    @font-face{
        font-family:'geo';
        src:url('../assets/geo.otf') format('opentype');
    }
    body{
        font-family: 'geo', sans-serif;
        background-color: #0f0f0f;
        color:#ffffff;
        margin: 0;
        box-sizing: border-box;
        background-image: url('../assets/bgs.jpg');
        background-size: cover;
        background-repeat: no-repeat;
        background-attachment: fixed;
        display: flex;
        height: 100vh;
    }
    h1{
        font-size: 2.5rem;
        margin:0;
    }
    .nav{
        width:23vw;
        padding:1.5rem;
        box-sizing: border-box;
        height: 100vh;
        display: flex;
        flex-direction: column;
        background-color:#0000008e;
        backdrop-filter:blur(15px);
        border-right:1px solid #3F6491;
    }
    .logo{
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 1.5rem;
    }
    hr{
        border: none;
        border-top: 1px solid rgba(255,255,255,0.6);
        border-radius: 1rem;
        width:100%;
        margin: 1rem 0;
        box-sizing: border-box;
    }
    .content{
        background-color:#00000046;
        height:100%;
        flex: 1;
        padding: 1.5rem;
        box-sizing:border-box;
        overflow-y: auto;
    }
    span{
        font-size: 1.5rem;
    }
    .btn{
        padding: 0.5rem 1rem;
        font-size: 1rem;
        border: none;
        border-radius: 7px;
        background-color: #1270D0;
        color: #ffffff;
        text-decoration: none;
        cursor: pointer;
        align-self: center;
        font-family: 'geo', sans-serif;
        width:100%;
        text-align: center;
        margin-block: 0.3rem;
    }
    .logout-btn{
        margin-top: auto;
        background-color: #002087;
        box-shadow: 0 0 10px rgba(18, 112, 208, 0.5);
    }
    .panel{
        margin-top: 2rem;
        display: grid;
        grid-template-columns: minmax(280px, 360px) 1fr;
        gap: 1rem;
        align-items: start;
    }
    .card{
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 12px;
        padding: 1rem;
        box-shadow: 0 0 18px rgba(0, 0, 0, 0.25);
    }
    .card h2{
        margin: 0 0 0.75rem 0;
        font-size: 1.4rem;
    }
    .field{
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-bottom: 0.9rem;
    }
    .field label{
        font-size: 0.95rem;
        color: #dcecff;
    }
    .field input{
        width: 100%;
        box-sizing: border-box;
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 8px;
        padding: 0.8rem 0.85rem;
        background: rgba(0,0,0,0.55);
        color: #ffffff;
        font-family: 'geo', sans-serif;
        font-size: 1rem;
    }
    .field input::placeholder{
        color: rgba(255,255,255,0.55);
    }
    .save-btn{
        width: 100%;
        margin-top: 0.25rem;
        background: linear-gradient(135deg, #1270D0, #0c4f9a);
    }
    .message{
        margin-bottom: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        background: rgba(8, 116, 159, 0.25);
        border: 1px solid rgba(255,255,255,0.12);
    }
    .vault{
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }
    .vault-card{
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 12px;
        padding: 1rem;
        box-shadow: 0 0 18px rgba(0, 0, 0, 0.25);
    }
    .vault-card h3{
        margin: 0 0 0.75rem 0;
        font-size: 1.2rem;
    }
    .vault-item{
        margin: 0.35rem 0;
        word-break: break-word;
    }
    .json-view{
        width: 100%;
        margin-top: 1rem;
        padding: 1rem;
        border-radius: 12px;
        background: rgba(0, 0, 0, 0.45);
        border: 1px solid rgba(255,255,255,0.12);
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-word;
    }
    </style>
    <link rel="icon" href="../assets/logo.png">
</head>
<body>
    <div class="nav">
        <div class="logo"><img src="../assets/logo.png" alt="Logo" width="50" height="50"><span>OneStore Unify</span></div>
        <hr>
        <a class="btn" href="/dashboard">Dashboard</a>
        <a class="btn" href="/passwords">Password Manager</a>
        <a class="btn logout-btn" href="/logout">OneStore Logout</a>
    </div>
    <div class="content">
        <span style="font-size: 1.25em;">Store and manage your saved passwords,</span>
        <h1><%= nickname || 'OneStore User' %></h1>
        <div class="panel">
            <div class="card">
                <h2>Add New Password</h2>
                <% if (locals.error) { %>
                    <div class="message"><%= locals.error %></div>
                <% } %>
                <form action="/passwords" method="POST">
                    <div class="field">
                        <label for="website">Website</label>
                        <input id="website" type="text" name="website" placeholder="example.com" required>
                    </div>
                    <div class="field">
                        <label for="username">Username</label>
                        <input id="username" type="text" name="username" placeholder="user@example.com" required>
                    </div>
                    <div class="field">
                        <label for="password">Password</label>
                        <input id="password" type="text" name="password" placeholder="Enter password" required>
                    </div>
                    <button class="btn save-btn" type="submit">Save Password</button>
                </form>
            </div>
            <div>
                <div class="card">
                    <h2>Saved Passwords</h2>
                    <% if (passwords && Object.keys(passwords).length) { %>
                        <div class="vault">
                            <% Object.entries(passwords).forEach(([index, entry]) => { %>
                                <div class="vault-card">
                                    <h3>Entry <%= index %></h3>
                                    <div class="vault-item"><strong>Website:</strong> <%= entry.website || '-' %></div>
                                    <div class="vault-item"><strong>Username:</strong> <%= entry.username || '-' %></div>
                                    <div class="vault-item"><strong>Password:</strong> <%= entry.password || '-' %></div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p>No saved passwords found yet.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>