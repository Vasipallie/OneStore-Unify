<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneStore Unify</title>
    <link rel="stylesheet" href="/styles.css">

    <style>
        
@import url('https://fonts.googleapis.com/css2?family=Stack+Sans+Notch:wght@200..700&display=swap');
body{
    font-family: "Stack Sans Notch", sans-serif;
    background-color: #0f0f0f;
    color:#ffffff;
    margin: 0;
    padding: 1rem;
    box-sizing: border-box;
    background-image: url('../assets/bgs.jpg');
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}
h1{
    font-size: 2.5rem;
    margin:0;
}
.logo{
    width:6rem;
    height:6rem;
}

.login-contain{
    display:flex;
    flex-direction:column;
    background-color: rgba(0,0,0,0.5);
    min-width:25vw;
    height: auto;
    padding: 2rem;
    align-items: center;
    text-align: center;
    border-radius: 10px;
    backdrop-filter: blur(10px);
}

.notify{
    margin-block:0.5rem;
    background-color: rgba(8, 116, 159, 0.274);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.274);
    border:1px solid #c2c2c2;
    padding: 0.5rem 1rem;
    border-radius: 5px;
}
input{
    width: 100%;
    padding: 0.5rem;
    margin: 0.5rem 0;
    border: none;
    border-radius: 5px;
    
}

input[type="email"]{
    background-color:#ffffff;
    color:#000000;
    font-family: 'geo', sans-serif;
    backdrop-filter: blur(15px);
    margin:0;
    margin-block-start: 0.5rem;
    font-size: 1rem;
}
form{
    width:100%;
}
input[type="password"]{
    background-color:#ffffff;
    color:#000000;
    font-family: 'geo', sans-serif;
    backdrop-filter: blur(15px);
    margin-block: 0.5rem;
    font-size: 1rem;
}
input::placeholder{
    color:#3b3b3b;
    opacity: 0.7;
}
.input-field,.login-btn{
    align-self: stretch;
    box-sizing: border-box;
    display: block;
    width: 100%;
}
.login-btn{
    padding: 0.5rem 1rem;
    font-size: 1rem;
    border: none;
    border-radius: 7px;
    background-color: #1270D0;
    color: #ffffff;
    cursor: pointer;
    font-family: 'geo', sans-serif;
}
    
hr{
    border: none;
    border-top: 1px solid rgb(81, 128, 185);
    border-radius: 1rem;
    width: 100%;
}
.cforgot{
    display:flex;
    flex-direction:row;
    justify-content: space-between;
    width:100%;
    margin-block: 0.5rem;
}
a{
    color:#d4e9ff;
    text-decoration: none;
}
a:hover{
    color:#7dbcff;
    text-decoration: none;
}
.strength{
    display:flex;
    flex-direction:column;
    gap:0.2rem;
    margin-bottom:1.5rem;
    text-align: left;
    color:#ebebebef;
    font-weight: 100;
    font-size: 0.9rem;

}
.displ{
    display:flex;
    flex-direction:row;
    gap:0.2rem;
    width:100%;
}
.color{
    background-color: rgb(0, 174, 255);
    border-radius: 5px;
    padding: 0.2rem;
    width: 100%;
    margin-bottom:0.5rem;
}
.pws{
    width: 25%;
    height:0.3rem;
    background-color:#44CAE1;
}
    </style>
    <link rel="icon" href="../assets/logo.png">
</head>
<body>
    <div class="login-contain">
        <img src="../assets/logo.png" alt="OneStore Unify Logo" class="logo">
        <h1>OneStore Unify</h1>
        <span style="margin-block-end: 1.5rem;">Create your OneStore Unify account</span>
        <form method="POST" action="/create">
            <input type="text" name="nickname" placeholder="Nickname" class="input-field">
            <input type="email" name="email" placeholder="Email" class="input-field">
            <input type="password" name="password" id="pass" placeholder="Password" class="input-field">         
            <input type="password" name="confirm_password" id="confirm" placeholder="Confirm Password" class="input-field">
            <div class="strength">
                <div class="displ">
                    <div id="color1" class="pws" style="border-radius: 5px 0 0 5px;"></div>
                    <div id="color2" class="pws"></div>
                    <div id="color3" class="pws"></div>
                    <div id="color4" class="pws" style="border-radius: 0 5px 5px 0;"></div>
                </div>
            <span>Password Strength: <span id="strength-text">VeryWeak</span></span>
            </div>

            <button type="submit" class="login-btn">Create Account</button>
            <div class="cforgot">
                <a href="/login">Back to OneStore Login</a>
            </div>
        </form>
    </div>
    <script>
        const passwordInput = document.getElementById('pass');
        const strengthText = document.getElementById('strength-text');
        const colorBars = [document.getElementById('color1'), document.getElementById('color2'), document.getElementById('color3'), document.getElementById('color4')];
        passwordInput.addEventListener('input', function() {
            const password = passwordInput.value;
            let strength = 0;

            if (password.length >= 8) strength++;
            if (/[A-Z]/.test(password)) strength++;
            if (/[a-z]/.test(password)) strength++;
            if (/\d/.test(password)) strength++;
            if (/[@$!%*?&]/.test(password)) strength++;
            switch (strength) {
                case 0:
                case 1:
                    strengthText.textContent = 'Very Weak';
                    colorBars.forEach(bar => bar.style.backgroundColor = '#ff4d4d');
                    break;
                case 2:
                    strengthText.textContent = 'Weak';
                    colorBars.forEach((bar, index) => bar.style.backgroundColor = index < 2 ? '#ff944d' : '#44CAE1');
                    break;
                case 3:
                    strengthText.textContent = 'Moderate';
                    colorBars.forEach((bar, index) => bar.style.backgroundColor = index < 3 ? '#ffdb4d' : '#44CAE1');
                    break;
                case 4:
                    strengthText.textContent = 'Strong';
                    colorBars.forEach((bar, index) => bar.style.backgroundColor = index < 4 ? '#b3ff66' : '#44CAE1');
                    break;
                case 5:
                    strengthText.textContent = 'Very Strong';
                    colorBars.forEach(bar => bar.style.backgroundColor = '#66ff66');
                    break;
            }
        });
        
    </script>
</body>
</html>